# Dev image for the API and workers. Production images come in Phase 2 and will be
# multi-stage, non-root, and pinned by digest.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /usr/local/bin/uv

WORKDIR /app

# Dependency layer: copy only the manifests so edits to source don't bust the cache.
COPY pyproject.toml uv.lock ./
COPY packages/engine/pyproject.toml packages/engine/
COPY packages/remediation/pyproject.toml packages/remediation/
COPY packages/shared/pyproject.toml packages/shared/
COPY apps/api/pyproject.toml apps/api/
COPY workers/pyproject.toml workers/
RUN mkdir -p packages/engine/src/reweave_engine packages/remediation/src/reweave_remediation \
      packages/shared/src/reweave_shared workers/reweave_workers apps/api/config \
    && touch packages/engine/src/reweave_engine/__init__.py \
      packages/remediation/src/reweave_remediation/__init__.py \
      packages/shared/src/reweave_shared/__init__.py \
      workers/reweave_workers/__init__.py apps/api/config/__init__.py \
    && uv sync --all-packages --no-dev

COPY . .

EXPOSE 8000
