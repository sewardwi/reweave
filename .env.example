# Copy to .env for local work. Never commit .env — see PLAN.md §7.
# Every value here is a placeholder; nothing real belongs in this file.

DJANGO_SECRET_KEY=dev-only-not-a-secret
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://reweave:reweave@localhost:5432/reweave
REDIS_URL=redis://localhost:6379/0

# Anthropic API — adjudication and PR generation (D11). Metered; see the cost dashboard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# GitHub App (Phase 3). Least-privilege scopes only, per D9.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Stripe (Phase 5).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
